# Copy the required settings into application-local.properties.
# Keep the existing JWT_SECRET in that file.
# Replace the database name, username and password with your local PostgreSQL settings.
DB_URL=jdbc:postgresql://localhost:5432/YOUR_DATABASE_NAME
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Configure these services with your actual connection details.
REDIS_URL=redis://localhost:6379
MAIL_USERNAME=YOUR_EMAIL
# Gmail: enable 2-Step Verification and create an App Password (not your login password).
# https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=YOUR_MAIL_APP_PASSWORD
